[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0
external_media_address={{ ansible_host }}
external_signaling_address={{ ansible_host }}
local_net=172.31.0.0/16

{% for extension in extensiones %}
[{{ extension.numero }}]
type=endpoint
context=sets
auth={{ extension.numero }}
aors={{ extension.numero }}
disallow=all
allow=ulaw
allow=alaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[{{ extension.numero }}]
type=auth
auth_type=userpass
username={{ extension.numero }}
password={{ extension.password }}

[{{ extension.numero }}]
type=aor
max_contacts=1
qualify_frequency=30
{% endfor %}